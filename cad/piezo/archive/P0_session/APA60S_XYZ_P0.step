#15783=PRODUCT('2026-09-07-17-20-34-071',
'APA60S XYZ - P0 Packaging and Guide Concept',
'PRELIMINARY ONLY. X optical / Y lateral / Z up. 300 g capacity target
, normal holder represented by an unverified lightweight envelope. No 
FEA or manufacturing release. See README in exported folder.',(#15781));
#15784=PRODUCT('2026-09-07-17-20-34-144',
'00 Coarse carriage adapter - preliminary',$,(#15781));
#15785=PRODUCT('2026-09-07-17-20-34-420','10 X AXIS - optical - outer',

'CONCEPT P0: local Y is motion, local Z is guide depth. Sharp leaf roo
ts and coupling require FEA/redesign before manufacture. No motion joi
nts represent elastic deformation.',(#15781));
